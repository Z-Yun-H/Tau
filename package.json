{
  "name": "tau-tool",
  "version": "0.4.0",
  "private": true,
  "description": "Tau — AI-powered unified terminal assistant. Natural language in, safe commands out.",
  "license": "MIT",
  "author": "Z-Yun-H",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Z-Yun-H/Tau.git"
  },
  "keywords": [
    "cli",
    "terminal",
    "ai",
    "assistant",
    "agent",
    "skills",
    "developer-tools",
    "mcp",
    "deepseek",
    "model-context-protocol",
    "plugins",
    "monorepo",
    "pnpm"
  ],
  "type": "module",
  "packageManager": "pnpm@12.2.1",
  "engines": {
    "node": ">=20.19.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=22.18.0"
    }
  },
  "scripts": {
    "dev": "tsx --conditions=development app/cli/src/index.ts",
    "build": "tsdown && pnpm --filter @tau/tui build && pnpm --filter @tau/webui build",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint packages app",
    "lint:fix": "oxlint --fix packages app",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "dev:tui": "tsx --conditions=development app/tui/src/index.ts",
    "dev:web": "tsx --conditions=development app/webui/src/index.ts"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "tsdown": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
