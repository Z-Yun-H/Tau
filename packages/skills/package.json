{
  "name": "@tau/skills",
  "version": "0.2.0",
  "description": "Tau skills — SKILL.md schema, three-tier loader, bundled skills/templates",
  "license": "MIT",
  "author": "Z-Yun-H",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "bundled",
    "templates"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown"
  },
  "devDependencies": {
    "tsdown": "catalog:"
  },
  "dependencies": {
    "@tau/core": "workspace:*",
    "@tau/engine": "workspace:*",
    "@tau/ui": "workspace:*",
    "yaml": "catalog:",
    "zod": "catalog:"
  }
}
