  },
  "devDependencies": {
    "tsdown": "catalog:"
  },
  "dependencies": {
    "@tau/core": "workspace:*",
    "@tau/tools": "workspace:*",
    "@tau/ui": "workspace:*",
    "@tau/engine": "workspace:*",
    "@tau/ai": "workspace:*",
    "@tau/skills": "workspace:*",
    "@tau/plugins": "workspace:*",
    "@tau/agent": "workspace:*",
    "@tau/tui": "workspace:*",
    "@tau/webui": "workspace:*",
    "commander": "catalog:"
  }
}
