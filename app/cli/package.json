{
  "name": "@tau/cli",
  "version": "0.6.1",
  "description": "Tau terminal app — the commander CLI (bin: tau)",
  "license": "MIT",
  "author": "Z-Yun-H",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
