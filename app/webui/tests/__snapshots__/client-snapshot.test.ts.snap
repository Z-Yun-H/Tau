exports[`WebUI client — real browser DOM snapshots > agent mode: goal card with round thinking + file.read viewer > goal-card-with-file-viewer.dom.html 1`] = `
"<!----><div data-v-HASH="" class="user-row"><div data-v-HASH="" class="user-bubble" title="<ts>">read readme.md</div></div><article data-v-HASH="" data-v-HASH="" class="tau-card tau-surface plan-enter"><div data-v-HASH="" class="card-eyebrow"><span data-v-HASH="" class="eyebrow-label">goal</span><span data-v-HASH="" class="eyebrow-meta"> round 1/3 · via mock</span><!----></div><p data-v-HASH="" class="goal-intent">read readme.md</p><section data-v-HASH="" data-v-HASH="" class="think-panel"><button data-v-HASH="" class="think-head" type="button"><!----><span data-v-HASH="" class="think-label"><think-summary></span><svg data-v-HASH="" class="think-chevron" width="10" height="10" viewBox="0 0 10 10" fill="none" aria-hidden="true"><path data-v-HASH="" d="M2 3.5L5 6.5L8 3.5" stroke="currentColor" stroke-width="1.4"></path></svg></button><!----></section><ol data-v-HASH="" class="round-list"><li data-v-HASH="" class="round-item"><div data-v-HASH="" class="round-head"><span data-v-HASH="" class="round-index">R1</span><!----><span data-v-HASH="" class="tau-badge text-tau-ok border-tau-ok-edge bg-tau-ok-soft">low</span><span data-v-HASH="" class="round-status st-ok">ok</span></div><section data-v-HASH="" data-v-HASH="" class="think-panel"><button data-v-HASH="" class="think-head" type="button"><!----><span data-v-HASH="" class="think-label"><think-summary></span><svg data-v-HASH="" class="think-chevron" width="10" height="10" viewBox="0 0 10 10" fill="none" aria-hidden="true"><path data-v-HASH="" d="M2 3.5L5 6.5L8 3.5" stroke="currentColor" stroke-width="1.4"></path></svg></button><!----></section><p data-v-HASH="" class="round-expl">Show the contents of readme.md</p><ol data-v-HASH="" class="step-stream"><li data-v-HASH="" class=""><div data-v-HASH="" data-v-HASH="" class="tool-call"><div data-v-HASH="" class="call-head"><span data-v-HASH="" class="call-dot dot-ok"></span><code data-v-HASH="" class="call-name">file.read</code><!----><!----><button data-v-HASH="" class="args-toggle" type="button">args</button></div><div data-v-HASH="" class="file-viewer"><div data-v-HASH="" class="viewer-head"><span data-v-HASH="" class="viewer-path">readme.md</span><span data-v-HASH="" class="viewer-lang">markdown</span></div><div data-v-HASH="" class="viewer-body"><pre class="shiki one-dark-pro" style="background-color:#282c34;color:#abb2bf" tabindex="0"><code><span class="line"><span style="color:#ABB2BF">file.read readme.md — lines 1-9 of 9</span></span>
