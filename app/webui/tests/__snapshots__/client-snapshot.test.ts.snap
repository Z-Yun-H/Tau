<span class="line"></span>
<span class="line"><span style="color:#ABB2BF">Markdown fixture for the file.read viewer.</span></span>
<span class="line"></span>
<span class="line"><span style="color:#E5C07B">-</span><span style="color:#ABB2BF"> rendered through shiki with the detected language</span></span>
<span class="line"><span style="color:#E5C07B">-</span><span style="color:#ABB2BF"> language detection is the tool's own languageForFile</span></span>
<span class="line"></span>
<span class="line"><span style="color:#ABB2BF">GOAL_COMPLETE: file viewer ready</span></span></code></pre></div></div></div></li></ol><!----></li></ol><div data-v-HASH="" class="goal-answer md-body"><p>file viewer ready</p></div><!----><div data-v-HASH="" class="goal-foot"><span data-v-HASH="" class="goal-status status-ok">complete</span><span data-v-HASH="" class="flex-1"></span><!----></div></article>"
`;

exports[`WebUI client — real browser DOM snapshots > plan flow: streamed plan card → thinking open → result card > plan-card-with-thinking-collapsed.dom.html 1`] = `"<!----><div data-v-HASH="" class="user-row"><div data-v-HASH="" class="user-bubble" title="<ts>">find all *.md files</div></div><article data-v-HASH="" data-v-HASH="" class="tau-card tau-surface plan-enter" style="--v82fe8c2c: 40ms;"><div data-v-HASH="" class="card-eyebrow"><span data-v-HASH="" class="eyebrow-label">plan</span><span data-v-HASH="" class="tau-badge text-tau-ok border-tau-ok-edge bg-tau-ok-soft">low</span><span data-v-HASH="" class="eyebrow-meta">via Mock (offline demo)</span><span data-v-HASH="" class="eyebrow-meta">143 tok</span><!----></div><section data-v-HASH="" data-v-HASH="" class="think-panel"><button data-v-HASH="" class="think-head" type="button"><!----><span data-v-HASH="" class="think-label"><think-summary></span><svg data-v-HASH="" class="think-chevron" width="10" height="10" viewBox="0 0 10 10" fill="none" aria-hidden="true"><path data-v-HASH="" d="M2 3.5L5 6.5L8 3.5" stroke="currentColor" stroke-width="1.4"></path></svg></button><!----></section><div data-v-HASH="" class="md-body md-lead"><p>Recursively find files matching *.md under the current directory</p></div><ol data-v-HASH="" class="step-list"><li data-v-HASH="" data-v-HASH="" class="step-row"><span data-v-HASH="" class="step-marker">01</span><div data-v-HASH="" class="step-body"><div data-v-HASH="" class="step-head"><span data-v-HASH="" class="kind-tag tool">tool</span><code data-v-HASH="" class="step-name">file.find</code><code data-v-HASH="" class="step-args">pattern=*.md  path=.</code></div><p data-v-HASH="" class="step-reason">keyword matched file lookup</p></div></li></ol><!----><!----><div data-v-HASH="" class="actions"><button data-v-HASH="" class="run-btn tau-chrome-bg"><svg data-v-HASH="" class="run-icon" width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path data-v-HASH="" d="M3 2L10 6L3 10V2Z" fill="currentColor"></path></svg><span data-v-HASH="" class="run-label">Run plan</span></button><button data-v-HASH="" class="tau-btn tau-btn-danger-hover"> Discard </button><!----></div></article>"`;

