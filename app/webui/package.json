{
  "name": "@tau/webui",
  "version": "0.2.0",
  "description": "Tau local web interface — node HTTP API + Vue 3 / UnoCSS client (bin: tau-web)",
  "license": "MIT",
  "author": "Z-Yun-H",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "tau-web": "./dist/index.js"
  },
  "scripts": {
    "dev": "vite dev",
    "dev:server": "tsx --conditions=development src/index.ts",
    "build": "vite build && vite build -c vite.server.config.ts",
    "shots": "tsx --conditions=development scripts/screenshot.mjs"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "catalog:",
    "tsx": "catalog:",
    "unocss": "catalog:",
    "vite": "catalog:",
    "vue": "catalog:",
    "playwright-core": "catalog:"
  },
  "dependencies": {
    "@tau/agent": "workspace:*",
    "@tau/core": "workspace:*",
    "@tau/engine": "workspace:*",
    "@tau/markdown": "workspace:*",
    "@vueuse/core": "catalog:",
    "shiki": "catalog:"
  }
}
