  },
  "devDependencies": {
    "vite": "catalog:"
  },
  "dependencies": {
    "@tau/agent": "workspace:*",
    "@tau/core": "workspace:*",
    "@tau/engine": "workspace:*",
    "@tau/markdown": "workspace:*",
    "@tau/ui": "workspace:*"
  }
