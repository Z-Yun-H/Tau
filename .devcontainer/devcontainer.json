{
  "name": "Tau Dev",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:24-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/git:1": {}
  },
  "containerEnv": {
    "TAU_HOME": "${localWorkspaceFolder}/.tau",
    "TAU_PROVIDER": "mock"
  },
  "customizations": {
    "vscode": {
      "extensions": ["oxc.oxc-vscode", "editorconfig.editorconfig", "vitest.explorer"],
      "settings": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "oxc.oxc-vscode",
        "typescript.tsdk": "node_modules/typescript/lib"
      }
    }
  },
  "postCreateCommand": "corepack enable pnpm && pnpm install && pnpm build",
  "remoteUser": "node"
}
